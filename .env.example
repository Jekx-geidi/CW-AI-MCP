# Octelium mesh connection for the cw-postgres-mcp WORKLOAD identity.
# Ivan has drafted the identity (already in cw-data-readers) but is waiting on
# us to confirm the name before minting the auth-token Credential. Once minted,
# paste it below — never commit the real token, this file is the .example only.
OCTELIUM_DOMAIN=access.geidi.com
OCTELIUM_AUTH_TOKEN=

# cw-postgres via Octelium. Secretless: Octelium injects the real cw_agent
# credential upstream, so any username works and no password is needed here.
# Source: Ivan, comment on GEIDIMCP-51 (2026-09-15).
OCTELIUM_CW_POSTGRES_URL=postgresql://cw_agent@cw-postgres.default.local.access.geidi.com:5432/cw

# postgres-mcp SSE listen port (what the gateway will point at)
POSTGRES_MCP_PORT=8000
