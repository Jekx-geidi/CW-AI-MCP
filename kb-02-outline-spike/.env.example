# Local KB-02 Outline evaluation spike — self-hosted, throwaway instance.
# Copy to .env and fill in SECRET_KEY / UTILS_SECRET (openssl rand -hex 32 each).

# NODE_ENV must be "production" — the published Docker image is a production
# build with no Vite dev server included. "development" makes the HTML shell
# reference unbuilt source (/static/app/index.tsx, @vite/client) that this
# image can't serve, which loads as a blank/black screen in the browser.
NODE_ENV=production
SECRET_KEY=
UTILS_SECRET=
URL=http://localhost:3100
PORT=3000
FORCE_HTTPS=false

# Local Postgres container has no SSL listener; Sequelize defaults to
# requiring SSL in production mode, which fails the connection without this.
PGSSLMODE=disable

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Gate 4 (Entra SSO, collection-level permissions) — needs Ivan to register an
# App registration (redirect URI http://localhost:3000/auth/oidc.callback) before
# this can be tested. Leave blank until then; the other 5 gates don't need it.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_DISPLAY_NAME=Geidi Entra

# At least one auth method must work without OIDC to log in and test gates 1-3/5/6.
# SMTP_HOST/PORT/SMTP_FROM_EMAIL are set directly in docker-compose.yml, pointed
# at the bundled Mailhog catcher (http://localhost:8025) — sign-in emails land
# there instead of a real inbox. See README.md for the sign-in steps.
ENABLE_UPDATES=false
