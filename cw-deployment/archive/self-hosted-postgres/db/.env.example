# CW PostgreSQL (Stage 2) — non-secret configuration. Copy to db/.env.
# Secrets go in db/secrets/ (mode 600): cw_pg_superuser_password,
# octelium_db_auth_token. Never here.

# Root of the DEDICATED disk for CW Postgres (MIGRATION.md §3).
# Must contain data/ and dumps/ (created by the operator, see DEPLOYMENT.md).
# Do NOT point this at /var/lib/docker.
CW_PG_ROOT=/srv/cw-postgres

# Octelium cluster domain and the Service this host will serve at cutover.
OCTELIUM_DOMAIN=access.geidi.com
CW_DB_OCTELIUM_SERVICE=cw-postgres
