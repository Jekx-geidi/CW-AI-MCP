# CW MCP Stage 1 — non-secret configuration. Copy to .env on the server.
# This file holds NO secrets. The Octelium auth token goes in
# ./secrets/octelium_auth_token (mode 600), never here.

# Octelium cluster domain.
OCTELIUM_DOMAIN=access.geidi.com

# Octelium Service this workload serves; Janus's Proxy URL routes to it.
CW_MCP_OCTELIUM_SERVICE=cw-postgres-mcp

# cw-postgres through Octelium. Secretless: Octelium injects the real
# cw_agent credential upstream, so no password belongs here.
# Unchanged from the laptop stack (Ivan, GEIDIMCP-51, 2026-09-15).
CW_POSTGRES_URL=postgresql://cw_agent@cw-postgres.default.local.access.geidi.com:5432/cw
